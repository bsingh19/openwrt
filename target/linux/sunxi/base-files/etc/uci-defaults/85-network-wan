#!/bin/sh

# Configure eth0 as WAN (internet source) for Orange Pi Zero 3
# eth0 will be the primary internet connection

# Remove eth0 from LAN bridge
uci del_list network.lan.device='eth0'

# Create WAN interface on eth0
uci set network.wan='interface'
uci set network.wan.device='eth0'
uci set network.wan.proto='dhcp'
uci set network.wan.metric='10'

# Ensure firewall zones are correct
uci set firewall.@zone[1].network='wan wwan'

# Commit changes
uci commit network
uci commit firewall

exit 0
