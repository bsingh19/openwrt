--- a/unisocwifi/cfg80211.c
+++ b/unisocwifi/cfg80211.c
@@ -16,6 +16,14 @@
 #include "cmdevt.h"
 #include "txrx.h"
 
+/* Kernel 6.6+ removed cfg80211_get_bss in favor of cfg80211_get_bss_multi */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 6, 0)
+#define cfg80211_get_bss(wiphy, channel, bssid, ssid, ssid_len, bss_type, privacy) \
+	cfg80211_get_bss_multi(wiphy, bssid, ssid, ssid_len, \
+			       IEEE80211_BSS_TYPE_ESS, \
+			       IEEE80211_PRIVACY_ANY)
+#endif
+
 static int sprdwl_cfg80211_scan(struct wiphy *wiphy,
 			       struct cfg80211_scan_request *request);
 static int sprdwl_cfg80211_connect(struct wiphy *wiphy, struct net_device *ndev,
