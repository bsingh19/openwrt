#!/bin/sh /etc/rc.common
# WiFi connection via manual wpa_supplicant (for UWE5622 compatibility)

START=99
STOP=10

start() {
    # Wait for interface
    [ -e /sys/class/net/wlan0 ] || return 1
    
    # Create wpa_supplicant config
    cat > /tmp/wpa.conf << 'EOF'
network={
    ssid="CEMSI"
    psk="$v7akng9!$"
}
EOF
    
    # Bring up interface
    ip link set wlan0 up
    
    # Start wpa_supplicant
    /usr/sbin/wpad wpa_supplicant -B -i wlan0 -c /tmp/wpa.conf -D nl80211
    
    # Wait for connection
    sleep 10
    
    # Get IP via DHCP
    udhcpc -i wlan0 -b -p /var/run/udhcpc-wlan0.pid
}

stop() {
    killall wpad 2>/dev/null
    killall udhcpc 2>/dev/null
    ip link set wlan0 down
}
