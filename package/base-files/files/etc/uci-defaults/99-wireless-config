#!/bin/sh
# Configure UWE5622 WiFi for station mode on first boot
# Ethernet as WAN (DHCP client) - main internet source
# WiFi connects to CEMSI in station mode for testing

# Check if radio0 exists
[ -e /sys/class/ieee80211/phy0 ] || exit 0

# Configure ethernet as WAN with DHCP (internet source)
uci batch << EOF
delete network.lan
set network.wan=interface
set network.wan.device='eth0'
set network.wan.proto='dhcp'
commit network
EOF

# Configure radio0 for 2.4GHz station mode
uci batch << EOF
set wireless.radio0.disabled='0'
set wireless.radio0.band='2g'
set wireless.radio0.channel='auto'
delete wireless.radio0.htmode
set wireless.default_radio0.mode='sta'
set wireless.default_radio0.ssid='CEMSI'
set wireless.default_radio0.encryption='psk2'
set wireless.default_radio0.key='$v7akng9!\$'
set wireless.default_radio0.network='wwan'
commit wireless
EOF

# Create wwan network interface for WiFi station testing
uci batch << EOF
set network.wwan=interface
set network.wwan.proto='dhcp'
commit network
EOF

exit 0
